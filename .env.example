# Copy to .env and fill in. .env is git-ignored and never uploaded to training jobs.

# Either static/temporary credentials...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS/SSO) credentials
AWS_SESSION_TOKEN=
# ...or a named profile from ~/.aws/config instead of the three keys above
# AWS_PROFILE=

AWS_REGION=us-east-1

# Optional: Hugging Face token for gated models / pushing to the Hub.
# `make infra` stores it in SSM Parameter Store; jobs read it at startup.
HF_TOKEN=

# Optional: prefix for AWS resource names (lowercase, hyphens)
# PROJECT_NAME=sft-sagemaker
