# Generated by Terraform (infra/). Do not edit by hand; run `make infra` instead.
# Schema: https://sagemaker.readthedocs.io/en/stable/overview.html#configuring-and-using-defaults-with-the-sagemaker-python-sdk
SchemaVersion: '1.0'
SageMaker:
  PythonSDK:
    Modules:
      Session:
        DefaultS3Bucket: ${bucket}
        DefaultS3ObjectKeyPrefix: sagemaker
      RemoteFunction:
        RoleArn: ${role_arn}
        S3RootUri: ${remote_function_s3_root}
        EnvironmentVariables:
          SFT_MODEL_OUTPUT_S3_URI: ${model_output_s3_uri}
%{ if hf_token_parameter != "" ~}
          SFT_HF_TOKEN_SSM_PARAMETER: ${hf_token_parameter}
%{ endif ~}
        Tags:
%{ for key, value in tags ~}
          - Key: ${key}
            Value: ${value}
%{ endfor ~}
